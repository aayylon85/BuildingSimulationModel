{
  "_comment": "Test Configuration for LLM-based Occupant Agents - 1-day simulation with 1-day warmup",
  "_unit_conventions": {
    "temperature": "degrees Celsius (C)",
    "length": "meters (m)",
    "area": "square meters (m2)",
    "power": "Watts (W)",
    "angles": "degrees",
    "time": "see key suffix (_minutes, _days, _hours, etc.)"
  },

  "simulation_settings": {
    "dt_minutes": 1,
    "duration_days": 1,
    "start_date": "2026-01-01",
    "stabilization_days": 3,
    "hvac_coupling_mode": "auto",
    "hvac_max_power_rate_w_s": 50000.0,
    "enable_opaque_solar_absorption": true,
    "interior_radiation_method": "area_weighted",
    "use_adaptive_timestepping": true
  },

  "location": {
    "latitude": 50.9105,
    "longitude": -1.4049,
    "place_name": "Southampton",
    "time_zone": "GMT"
  },

  "zone_properties": {
    "name": "Office_Main",
    "length": 10.0,
    "width": 8.0,
    "height": 2.8,
    "zone_sensible_heat_capacity_multiplier": 4.0
  },

  "geometry": {
    "exterior_surfaces": [
      "north_wall",
      "east_wall",
      "south_wall",
      "west_wall",
      "roof"
    ],
    "surface_definitions": {
      "north_wall": {"area": 22.4, "perimeter": 21.6, "tilt": 90, "azimuth": 0, "type": "wall", "roughness_index": 2, "construction_name": "ExteriorWall"},
      "east_wall": {"area": 28.0, "perimeter": 21.6, "tilt": 90, "azimuth": 90, "type": "wall", "roughness_index": 2, "construction_name": "ExteriorWall"},
      "south_wall": {"area": 22.4, "perimeter": 21.6, "tilt": 90, "azimuth": 180, "type": "wall", "roughness_index": 2, "construction_name": "ExteriorWall"},
      "west_wall": {"area": 28.0, "perimeter": 21.6, "tilt": 90, "azimuth": 270, "type": "wall", "roughness_index": 2, "construction_name": "ExteriorWall"},
      "roof": {"area": 80.0, "perimeter": 36.0, "tilt": 0, "azimuth": 0, "type": "roof", "roughness_index": 3, "construction_name": "ExteriorWall"},
      "floor": {"area": 80.0, "perimeter": 36.0, "tilt": 180, "azimuth": 0, "type": "floor", "roughness_index": 3, "construction_name": "SlabFloor"}
    }
  },

  "materials": [
    {
      "name": "Concrete",
      "thickness": 0.1,
      "conductivity": 1.4,
      "density": 2300,
      "specific_heat": 880
    },
    {
      "name": "Insulation",
      "thickness": 0.05,
      "conductivity": 0.04,
      "density": 30,
      "specific_heat": 1200
    }
  ],

  "constructions": {
    "ExteriorWall": {
      "layers": [
        "Concrete",
        "Insulation",
        "Concrete"
      ]
    },
    "SlabFloor": {
      "layers": [
        "Concrete"
      ]
    }
  },

  "windows": [
    {
      "wall_name": "south_wall",
      "area": 6.0,
      "u_value": 1.5,
      "shgc": 0.5,
      "solar_distribution": {
        "floor": 0.6,
        "north_wall": 0.2,
        "east_wall": 0.1,
        "west_wall": 0.1
      }
    }
  ],

  "air_exchange": {
    "infiltration": {
      "flow_coefficient_m3_s_Pa_n": 0.00025,
      "pressure_exponent_n": 0.65,
      "stack_coeff_Pa_K": 0.078,
      "wind_coeff_Pa_s2_m2": 0.15,
      "shelter_factor_s": 0.5
    },
    "ventilation": {
      "open_window_ach": 5.0
    }
  },

  "hvac_system": {
    "model_type": "PIDControlledHVAC",
    "heating_capacity_w": 5000.0,
    "cooling_capacity_w": 5000.0,
    "heating_deadband_c": 1.0,
    "cooling_deadband_c": 1.0,
    "min_runtime_minutes": 60.0,
    "min_offtime_minutes": 10.0,
    "ramp_up_minutes": 30.0
  },

  "schedules": {
    "occupied_hours": [7, 19],
    "occupied_heating_setpoint_c": 21.0,
    "unoccupied_heating_setpoint_c": 15.0,
    "occupied_cooling_setpoint_c": 24.0,
    "unoccupied_cooling_setpoint_c": 30.0,
    "occupied_internal_gains_w": 0.0,
    "unoccupied_internal_gains_w": 0.0
  },

  "occupancy": {
    "_comment": "Rule-based occupants (used when llm_agents.enabled = false)",
    "heat_gain_per_occupant_w": 120.0,
    "check_interval_minutes": 60,
    "thermostat_adjustment_c": 1.0,
    "occupants": []
  },

  "llm_agents": {
    "_comment": "LLM-based occupant agents using OpenAI API with generative agent architecture",
    "enabled": true,
    "api_timeout_seconds": 30,
    "agent_model": "gpt-5.2",
    "embed_model": "text-embedding-3-large",
    "decision_interval_minutes": 60,
    "daily_planning_hour": 0,
    "agent_source": {
      "_comment": "Agent initialization: 'fresh' copies from base_types_folder, 'continue' uses previous run",
      "mode": "fresh",
      "base_types_folder": "agent_base_types",
      "continue_from_run": null
    },
    "_agents_note": "Agent properties (personality, schedule, core_memories, preferences) come from agent_base_types/{base_type}/ folder. Only id and base_type are required here.",
    "agents": [
      {"id": "alice_001", "base_type": "alice_office_worker"},
      {"id": "bob_002", "base_type": "bob_office_worker"},
      {"id": "charlie_003", "base_type": "charlie_office_worker"}
    ]
  },

  "desks": {
    "Desk_A": {
      "equipment": ["laptop_A", "monitor_A"],
      "light": "desk_light_A"
    },
    "Desk_B": {
      "equipment": ["laptop_B", "monitor_B"],
      "light": "desk_light_B"
    },
    "Desk_C": {
      "equipment": ["laptop_C", "monitor_C"],
      "light": "desk_light_C"
    }
  },

  "equipment": {
    "default_power_w": {
      "laptop": 50,
      "monitor": 30,
      "photocopier_standby": 20,
      "photocopier_active": 400,
      "desktop_computer": 150,
      "projector": 200,
      "conference_phone": 10
    },
    "shared_equipment": ["photocopier"],
    "items": {
      "laptop_A": {"type": "laptop", "location": "Desk_A"},
      "laptop_B": {"type": "laptop", "location": "Desk_B"},
      "laptop_C": {"type": "laptop", "location": "Desk_C"},
      "monitor_A": {"type": "monitor", "location": "Desk_A"},
      "monitor_B": {"type": "monitor", "location": "Desk_B"},
      "monitor_C": {"type": "monitor", "location": "Desk_C"},
      "photocopier": {"type": "photocopier", "location": "shared"},
      "projector": {"type": "projector", "location": "meeting_room"},
      "conference_phone": {"type": "conference_phone", "location": "meeting_room"}
    }
  },

  "lighting": {
    "desk_light_power_w": 15,
    "zone_light_power_w": 200,
    "meeting_room_light_power_w": 100,
    "zones": {
      "desk_light_A": {"power_w": 15, "location": "Desk_A"},
      "desk_light_B": {"power_w": 15, "location": "Desk_B"},
      "desk_light_C": {"power_w": 15, "location": "Desk_C"},
      "zone_main": {"power_w": 200, "location": "shared"},
      "meeting_room": {"power_w": 100, "location": "meeting_room"}
    }
  },

  "meeting_room": {
    "capacity": 6,
    "equipment": ["projector", "conference_phone"],
    "light": "meeting_room"
  },

  "room_layout": {
    "description": "Open plan office with south-facing windows",
    "desks": {
      "Desk_A": {
        "position": "South wall, near window",
        "characteristics": ["Good natural light", "Can see outside", "Near entrance"],
        "pros": "Best natural light in the morning and afternoon",
        "cons": "Can be warm on sunny days, near foot traffic"
      },
      "Desk_B": {
        "position": "East wall, corner",
        "characteristics": ["Window view", "Corner position", "Near photocopier"],
        "pros": "Morning light, some privacy from corner",
        "cons": "Photocopier noise nearby"
      },
      "Desk_C": {
        "position": "North wall, interior",
        "characteristics": ["Away from windows", "Quiet area", "Near meeting room"],
        "pros": "Quietest spot, no direct sun glare",
        "cons": "Less natural light, needs desk lamp more often"
      }
    },
    "meeting_room": {
      "position": "North-east corner",
      "characteristics": ["Enclosed", "Whiteboard", "Video conferencing"]
    },
    "shared_areas": {
      "photocopier": "Near Desk_B",
      "entrance": "South wall, near Desk_A"
    }
  },

  "weather": {
    "type": "file",
    "temp_base_c": -10,
    "temp_amplitude_c": 3,
    "temp_phase_shift_hr": 14,
    "solar_max_irradiance_w_m2": 400,
    "wind_Speed_ms": 20.0
  },

  "convection_models": {
    "_comment": "ASHRAE 140 validated settings - DOE2 exterior, ASHRAE_Simple interior",
    "exterior_hf": {
      "RoofStable": "DOE2Windward",
      "RoofUnstable": "DOE2Windward",
      "VerticalWallWindward": "DOE2Windward",
      "VerticalWallLeeward": "DOE2Leeward"
    },
    "exterior_hn": {
      "RoofStable": "WaltonStableHorizontalOrTilt",
      "RoofUnstable": "WaltonUnstableHorizontalOrTilt",
      "VerticalWallWindward": "ASHRAEVerticalWall",
      "VerticalWallLeeward": "ASHRAEVerticalWall"
    },
    "interior": {
      "VerticalWall": "ASHRAEVerticalWall",
      "UnstableHorizontal": "WaltonUnstableHorizontalOrTilt",
      "StableHorizontal": "WaltonStableHorizontalOrTilt",
      "UnstableTilted": "WaltonUnstableHorizontalOrTilt",
      "StableTilted": "WaltonStableHorizontalOrTilt",
      "HeatedFloor": "WaltonUnstableHorizontalOrTilt",
      "CooledFloor": "WaltonStableHorizontalOrTilt",
      "HeatedCeiling": "WaltonUnstableHorizontalOrTilt",
      "CooledCeiling": "WaltonStableHorizontalOrTilt"
    }
  }
}
